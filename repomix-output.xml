@Composable
fun PantallaAjustes(
    onAjustesAlertaClick: () -> Unit,
    onAcercaClick: () -> Unit
) {
    val config = LocalConfiguration.current
    val screenDp = config.screenWidthDp.dp
    val paddingH = screenDp * 0.10f
    val paddingV = screenDp * 0.12f

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Negro)
